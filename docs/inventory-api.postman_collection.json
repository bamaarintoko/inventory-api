{
    "info": {
      "name": "Inventory API",
      "description": "Sistem Manajemen Inventaris Barang. Jalankan Login dulu; token otomatis tersimpan ke variabel {{token}}.",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      { "key": "baseUrl", "value": "http://localhost:3000" },
      { "key": "token", "value": "" },
      { "key": "itemId", "value": "1" }
    ],
    "item": [
      {
        "name": "Auth",
        "item": [
          {
            "name": "Register",
            "request": {
              "method": "POST",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
              "body": { "mode": "raw", "raw": "{\n  \"name\": \"Bama\",\n  \"email\": \"bama@test.com\",\n  \"password\": \"rahasia123\"\n}" }
            }
          },
          {
            "name": "Login",
            "request": {
              "method": "POST",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
              "body": { "mode": "raw", "raw": "{\n  \"email\": \"bama@test.com\",\n  \"password\": \"rahasia123\"\n}" }
            },
            "event": [{
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "}"
                ]
              }
            }]
          }
        ]
      },
      {
        "name": "Items",
        "item": [
          {
            "name": "Create Item",
            "request": {
              "method": "POST",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Authorization", "value": "Bearer {{token}}" }
              ],
              "url": { "raw": "{{baseUrl}}/items", "host": ["{{baseUrl}}"], "path": ["items"] },
              "body": { "mode": "raw", "raw": "{\n  \"name\": \"Laptop\",\n  \"description\": \"ThinkPad\",\n  \"stock\": 1,\n  \"price\": 8500000\n}" }
            },
            "event": [{
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) pm.collectionVariables.set('itemId', res.data.id);"
                ]
              }
            }]
          },
          {
            "name": "List Items (search & pagination)",
            "request": {
              "method": "GET",
              "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
              "url": {
                "raw": "{{baseUrl}}/items?search=lap&page=1&limit=10",
                "host": ["{{baseUrl}}"],
                "path": ["items"],
                "query": [
                  { "key": "search", "value": "lap" },
                  { "key": "page", "value": "1" },
                  { "key": "limit", "value": "10" }
                ]
              }
            }
          },
          {
            "name": "Update Item",
            "request": {
              "method": "PUT",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Authorization", "value": "Bearer {{token}}" }
              ],
              "url": { "raw": "{{baseUrl}}/items/{{itemId}}", "host": ["{{baseUrl}}"], "path": ["items", "{{itemId}}"] },
              "body": { "mode": "raw", "raw": "{\n  \"name\": \"Laptop\",\n  \"description\": \"ThinkPad X1\",\n  \"stock\": 5,\n  \"price\": 9000000\n}" }
            }
          },
          {
            "name": "Adjust Stock (atomic)",
            "request": {
              "method": "PATCH",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Authorization", "value": "Bearer {{token}}" }
              ],
              "url": { "raw": "{{baseUrl}}/items/{{itemId}}/stock", "host": ["{{baseUrl}}"], "path": ["items", "{{itemId}}", "stock"] },
              "body": { "mode": "raw", "raw": "{\n  \"quantity\": -1\n}" }
            }
          },
          {
            "name": "Delete Item",
            "request": {
              "method": "DELETE",
              "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
              "url": { "raw": "{{baseUrl}}/items/{{itemId}}", "host": ["{{baseUrl}}"], "path": ["items", "{{itemId}}"] }
            }
          }
        ]
      }
    ]
  }